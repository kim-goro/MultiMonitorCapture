<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{7B1F3C2A-9E4D-4C1B-9A21-8F5D6E2A0C31}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>MultiMonitorCapture</RootNamespace>
    <AssemblyName>MultiMonitorCapture</AssemblyName>
    <TargetFrameworkVersion>v4.0</TargetFrameworkVersion>
    <FileAlignment>512</FileAlignment>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Data" />
    <Reference Include="System.Xml" />
  </ItemGroup>
  <ItemGroup>
    <!-- 빌드 전용 참조 어셈블리. exe 에 포함되지 않으며 런타임 종속성이 아니다. -->
    <!-- IDE 인텔리센스 해결과 4.0 API 표면 보장을 위해 사용한다. -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net40" Version="1.0.3">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>
  <ItemGroup>
    <!-- obj/bin 의 자동생성 소스와 빌드정보 생성 파일을 글롭에서 제외한다. -->
    <!-- 빌드정보 파일은 아래 GenerateBuildInfo 타겟이 매 빌드마다 직접 추가한다 -->
    <!-- (첫 빌드 시점엔 아직 파일이 없어 글롭이 못 잡으므로 명시적으로 추가해야 한다). -->
    <Compile Include="**\*.cs" Exclude="obj\**\*.cs;bin\**\*.cs;Properties\BuildInfo.Generated.cs" />
  </ItemGroup>
  <ItemGroup>
    <None Include="app.manifest" />
  </ItemGroup>

  <PropertyGroup>
    <BuildInfoFile>$(MSBuildProjectDirectory)\Properties\BuildInfo.Generated.cs</BuildInfoFile>
  </PropertyGroup>

  <!-- 빌드마다 빌드일자/커밋해시를 자동 주입한다. CI/CD 서버 없이 로컬 dotnet build 만으로 동작한다. -->
  <Target Name="GenerateBuildInfo" BeforeTargets="CoreCompile">
    <Exec Command="powershell -NoProfile -ExecutionPolicy Bypass -File &quot;$(MSBuildProjectDirectory)\..\build\generate-buildinfo.ps1&quot; -OutputPath &quot;$(BuildInfoFile)&quot;" />
    <ItemGroup>
      <Compile Include="$(BuildInfoFile)" />
    </ItemGroup>
  </Target>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
